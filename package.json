{
  "name": "@milicazm/selfies-js",
  "version": "2.0.1",
  "description": "JavaScript/TypeScript implementation of SELFIES - a molecular string representation for machine learning in chemistry",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "selfies": "node selfies-cli.js"
  },
  "keywords": [
    "selfies",
    "chemistry",
    "cheminformatics",
    "smiles",
    "molecular-representation",
    "machine-learning",
    "drug-discovery",
    "molecules",
    "computational-chemistry"
  ],
  "author": "Milica Markovic",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/milicazmarkovic/selfies-js"
  },
  "bugs": {
    "url": "https://github.com/milicazmarkovic/selfies-js/issues"
  },
  "homepage": "https://github.com/milicazmarkovic/selfies-js",
  "bin": {
    "selfies": "./selfies-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "selfies-cli.js",
    "examples"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
